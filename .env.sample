# .env

# don't forget to run process.loadEnvFile() in app.js to load this file!


# for this project, ignore LOCAL_DB_URL and SERVER_DB_URL, I'm just storing those respective URLs here to copy into DATABASE_URL

# general template/structure: postgresql://{USER}:{PASSWORD}@{HOST}:{DBPORT}/{DATABASE}
LOCAL_DB_URL=''

# search for Node.js version of DB connection from your DB service of choice, and paste the link into the single quotes
# I don't know about other services, but for Neon, you also need to add this to the end of your URL: &sslmode=verify-full
SERVER_DB_URL=''


# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://{USER}:{PASSWORD}@{HOST}:{DBPORT}/{5432}?schema=public"
